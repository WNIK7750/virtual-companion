{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-companion.local/contracts/feedback-export.v1.schema.json",
  "title": "FeedbackExport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "created_at",
    "selected_feedback",
    "context_policy",
    "redaction_confirmed",
    "external_processing_confirmed",
    "payload",
    "payload_sha256",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "export_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "selected_feedback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feedback_id", "feedback_revision"],
        "properties": {
          "feedback_id": { "type": "string", "minLength": 1 },
          "feedback_revision": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preceding_turns", "following_turns"],
      "properties": {
        "preceding_turns": { "type": "integer", "minimum": 0, "maximum": 2 },
        "following_turns": { "const": 0 }
      }
    },
    "redaction_confirmed": { "const": true },
    "external_processing_confirmed": { "const": true },
    "payload": { "type": "object" },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["active", "stale"] }
  }
}
